# Written by `tonto gufo` from the tonto ontology longevidadehumana.
# Change the model and export it again, rather than this file.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix longevidadehumana: <https://remelards.github.io/ontologia-longevidade/longevidadehumana#> .

<https://remelards.github.io/ontologia-longevidade/longevidadehumana> a owl:Ontology ;
    rdfs:label "Longevidade Humana" ;
    rdfs:comment "Ontologia de Referência para a Longevidade Humana" ;
    owl:imports <http://purl.org/nemo/gufo#> ;
    dcterms:description "Ontologia de Referência para a Longevidade Humana" ;
    dcterms:title "Longevidade Humana" ;
    owl:versionInfo "0.2.0" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:creator "Breno Uliana De Angelo", "Rafael Fracalossi Freitas" ;
    vann:preferredNamespacePrefix "longevidadehumana" ;
    vann:preferredNamespaceUri "https://remelards.github.io/ontologia-longevidade/longevidadehumana#" .

longevidadehumana:ElementoGenomico a owl:Class, gufo:Category ;
    rdfs:label "ElementoGenomico" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf gufo:FunctionalComplex .

longevidadehumana:Gene a owl:Class, gufo:Kind ;
    rdfs:label "Gene" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        longevidadehumana:ElementoGenomico,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Gene.simbolo ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Gene.hgncId ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Variante a owl:Class, gufo:Kind ;
    rdfs:label "Variante" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        longevidadehumana:ElementoGenomico,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Variante.rsId ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Variante.descricao ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:ProcessoBiologico a owl:Class, gufo:Kind ;
    rdfs:label "ProcessoBiologico" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ProcessoBiologico.goId ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Celula a owl:Class, gufo:Kind ;
    rdfs:label "Celula" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Celula.tipoCelular_idCL ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Organizacao a owl:Class, gufo:Kind ;
    rdfs:label "Organizacao" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Organizacao.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:RecursoInformacional a owl:Class, gufo:Category ;
    rdfs:label "RecursoInformacional" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:RecursoInformacional.mantidoPor ;
          owl:someValuesFrom longevidadehumana:Organizacao ] .

longevidadehumana:ConjuntoDeDados a owl:Class, gufo:Kind ;
    rdfs:label "ConjuntoDeDados" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        longevidadehumana:RecursoInformacional,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ConjuntoDeDados.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ConjuntoDeDados.url ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Ontologia a owl:Class, gufo:Kind ;
    rdfs:label "Ontologia" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        longevidadehumana:RecursoInformacional,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Ontologia.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Ontologia.url ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Populacao a owl:Class, gufo:Kind ;
    rdfs:label "Populacao" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Populacao.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Estudo a owl:Class, gufo:Kind ;
    rdfs:label "Estudo" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:FunctionalComplex,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Estudo.nome ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:Estudo.pubmedId ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:Significancia a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "Significancia" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
                          owl:oneOf (
                              longevidadehumana:Significancia.NaoSignificativa
                              longevidadehumana:Significancia.Significativa
                          ) ] .

longevidadehumana:Significancia.Significativa a
        owl:NamedIndividual,
        longevidadehumana:Significancia ;
    rdfs:label "Significativa" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:Significancia.NaoSignificativa a
        owl:NamedIndividual,
        longevidadehumana:Significancia ;
    rdfs:label "NaoSignificativa" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        longevidadehumana:Significancia.NaoSignificativa
        longevidadehumana:Significancia.Significativa
    ) .

longevidadehumana:AssociacaoLongevidade a owl:Class, gufo:Kind ;
    rdfs:label "AssociacaoLongevidade" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.idNaFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.significancia ;
          owl:onClass longevidadehumana:Significancia ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.trait ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.pValor ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.avaliaElemento ;
          owl:someValuesFrom longevidadehumana:ElementoGenomico ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.obtidaEm ;
          owl:onClass longevidadehumana:Estudo ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.observadaEm ;
          owl:someValuesFrom longevidadehumana:Populacao ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AssociacaoLongevidade.registradaEm ;
          owl:onClass longevidadehumana:ConjuntoDeDados ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:MotivoGenAge a owl:Class, gufo:AbstractIndividualType ;
    rdfs:label "MotivoGenAge" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
                          owl:oneOf (
                              longevidadehumana:MotivoGenAge.Cell
                              longevidadehumana:MotivoGenAge.Downstream
                              longevidadehumana:MotivoGenAge.Functional
                              longevidadehumana:MotivoGenAge.Human
                              longevidadehumana:MotivoGenAge.HumanLink
                              longevidadehumana:MotivoGenAge.Mammal
                              longevidadehumana:MotivoGenAge.Model
                              longevidadehumana:MotivoGenAge.Putative
                              longevidadehumana:MotivoGenAge.Upstream
                          ) ] .

longevidadehumana:MotivoGenAge.Functional a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Functional" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Putative a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Putative" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Mammal a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Mammal" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Downstream a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Downstream" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Upstream a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Upstream" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Model a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Model" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Cell a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Cell" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.HumanLink a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "HumanLink" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

longevidadehumana:MotivoGenAge.Human a owl:NamedIndividual, longevidadehumana:MotivoGenAge ;
    rdfs:label "Human" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        longevidadehumana:MotivoGenAge.Cell
        longevidadehumana:MotivoGenAge.Downstream
        longevidadehumana:MotivoGenAge.Functional
        longevidadehumana:MotivoGenAge.Human
        longevidadehumana:MotivoGenAge.HumanLink
        longevidadehumana:MotivoGenAge.Mammal
        longevidadehumana:MotivoGenAge.Model
        longevidadehumana:MotivoGenAge.Putative
        longevidadehumana:MotivoGenAge.Upstream
    ) .

longevidadehumana:EvidenciaEnvelhecimento a owl:Class, gufo:Kind ;
    rdfs:label "EvidenciaEnvelhecimento" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:EvidenciaEnvelhecimento.idNaFonte ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:EvidenciaEnvelhecimento.motivo ;
          owl:someValuesFrom longevidadehumana:MotivoGenAge ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:EvidenciaEnvelhecimento.sobreGene ;
          owl:onClass longevidadehumana:Gene ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:EvidenciaEnvelhecimento.curadaPor ;
          owl:onClass longevidadehumana:ConjuntoDeDados ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:AnotacaoFuncional a owl:Class, gufo:Kind ;
    rdfs:label "AnotacaoFuncional" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.codigoEvidencia ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.referencia ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.anotaGene ;
          owl:onClass longevidadehumana:Gene ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.emProcesso ;
          owl:onClass longevidadehumana:ProcessoBiologico ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.anotadaEm ;
          owl:onClass longevidadehumana:ConjuntoDeDados ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:AnotacaoFuncional.baseadaEm ;
          owl:onClass longevidadehumana:Estudo ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

longevidadehumana:ExpressaoGenica a owl:Class, gufo:Kind ;
    rdfs:label "ExpressaoGenica" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:subClassOf
        gufo:Relator,
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ExpressaoGenica.nCPM ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ExpressaoGenica.expressaGene ;
          owl:onClass longevidadehumana:Gene ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ExpressaoGenica.emCelula ;
          owl:onClass longevidadehumana:Celula ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty longevidadehumana:ExpressaoGenica.medidaEm ;
          owl:onClass longevidadehumana:ConjuntoDeDados ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:AllDisjointClasses ;
    owl:members ( longevidadehumana:Gene longevidadehumana:Variante ) .

[] a owl:AllDisjointClasses ;
    owl:members ( longevidadehumana:ConjuntoDeDados longevidadehumana:Ontologia ) .

longevidadehumana:Gene.simbolo a owl:DatatypeProperty ;
    rdfs:label "simbolo" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:Gene ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

longevidadehumana:Gene.hgncId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "hgncId" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:Gene ;
    rdfs:range xsd:string ;
