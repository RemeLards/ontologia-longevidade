    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:Celula ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

