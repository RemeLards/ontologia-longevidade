    rdfs:domain longevidadehumana:Estudo ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

longevidadehumana:Estudo.pubmedId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "pubmedId" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:Estudo ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

longevidadehumana:AssociacaoLongevidade.idNaFonte a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "idNaFonte" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:AssociacaoLongevidade ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gufo:hasQualityValue .

longevidadehumana:AssociacaoLongevidade.significancia a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "significancia" ;
    rdfs:isDefinedBy <https://remelards.github.io/ontologia-longevidade/longevidadehumana> ;
    rdfs:domain longevidadehumana:AssociacaoLongevidade ;
    rdfs:range longevidadehumana:Significancia ;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue .

longevidadehumana:AssociacaoLongevidade.trait a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "trait" ;
