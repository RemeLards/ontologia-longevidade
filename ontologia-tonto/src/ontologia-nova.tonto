// ONTOLOGIA DE REFERÊNCIA PARA A LONGEVIDADE HUMANA — versão nova (junção)
// Junta os dois módulos avaliados por partes:
//   modulos/biologia/  -> seções 1 a 3 (genes, variantes, processos, células)
//   modulos/pesquisa/  -> seções 4 e 5 (organizações, recursos, estudos)
// e acrescenta a seção 6: os relatores que dizem QUEM afirma O QUÊ sobre qual gene.
// O modelo antigo continua em ontologia.tonto (mesma pasta).
//
// Regras do modelo:
//   - todo fato (relator) depende da fonte que o afirma (@mediation para a base);
//   - sem @material: só relatores e relações comuns;
//   - termos de GO, SO e CL entram como ID (atributo ou instância), não como classe;
//   - opcional ([0..1], [0..*]) só quando o domínio permite a falta (variante
//     intergênica, anotação sem estudo, haplótipo sem rsID). Falta de dado de uma
//     base se resolve no script (normaliza, deriva ou descarta), não no modelo.
//
// Caminhos das questões de competência:
//   QC1  Gene/Variante <- avaliaElemento <- AssociacaoLongevidade (significancia)
//   QC2  Gene avaliado numa AssociacaoLongevidade E com EvidenciaEnvelhecimento
//        (gene fora da GenAge simplesmente não tem evidência: FILTER EXISTS no SPARQL)
//   QC3  Gene <- AnotacaoFuncional -> ProcessoBiologico
//   QC4  (a) ProcessoBiologico <- AnotacaoFuncional -> ocorreEm -> Celula      (GO + CL)
//        (b) ProcessoBiologico <- AnotacaoFuncional -> Gene <- ExpressaoGenica -> Celula (HPA)
//   QC5  qualquer relator -> registradaEm/curadaPor/anotadaEm/medidaEm -> ConjuntoDeDados
//        (LongevityMap x GWAS: 29 rsIDs, 61 genes e 7 PMIDs em comum)
//
// Documentação: AVALIACAO_MODELO.md (estado geral)
//               modulos/biologia/src/FONTES_FORA_DA_PROPOSTA.md
//               modulos/pesquisa/src/PROBLEMAS.md
//               ontologia-tonto/src/PROBLEMAS_JUNCAO.md (modelagem e implementação)

/// Ontologia de Referência para a Longevidade Humana
/// @label Longevidade Humana
/// @namespace https://remelards.github.io/ontologia-longevidade/longevidadehumana#
/// @version 0.2.0
/// @license https://opensource.org/licenses/MIT
/// @creator Rafael Fracalossi Freitas
/// @creator Breno Uliana De Angelo
ontology longevidadehumana

// ===========================================================================
// 1. GENES E VARIANTES (genoma de referência)                  [mód. biologia]
// ===========================================================================

// Category (não-sortal rígido): agrupa dois kinds com identidades diferentes,
// Gene e Variante, só para o relator poder apontar para "gene ou variante".
// Não é mixin: mixin é semirrígido; gene e variante são sempre o que são.
category ElementoGenomico of functional-complexes

kind Gene {
    simbolo: string [1]          // ex.: APOE (nome oficial da HGNC)
    hgncId: const string [1]           // ex.: HGNC:613. Todo gene é normalizado na HGNC antes de
                                 // entrar; nome sem solução vai para o log, não vira Gene
}

kind Variante {
    rsId: const string [0..1]          // ex.: rs7412 (falta em parte da LongevityMap)
                                 // haplótipo (E2/E3/E4 = rs429358+rs7412) fica sem rsId,
                                 // só com descricao (PROBLEMAS_JUNCAO.md, seção 1)
    descricao: string [1]        // rótulo da fonte (ex.: -308G/A, E2/E3/E4)
    tipoSO: string [0..*]        // termo(s) da Sequence Ontology, ex.: SO:0001583 missense_variant
}

// Incompleto: outros elementos (promotores, enhancers) podem entrar depois.
disjoint genset TiposDeElemento {
    general ElementoGenomico
    specifics Gene, Variante
}

// Relação comum: decorre só da posição. 0..* (variantes intergênicas, genes sobrepostos).
relation Variante [0..*] -- localizadaEm -- [0..*] Gene

// ===========================================================================
// 2. PROCESSOS BIOLÓGICOS (GO)                                [mód. biologia]
// Cada termo GO (ex.: GO:0006281 "DNA repair") é uma instância.
// ===========================================================================

kind ProcessoBiologico {
    goId: const string [1]             // ID do termo GO (não do gene)
}

// Hierarquia da GO entre os termos (is_a e part_of do go-basic). Auto-relação:
// cada termo aponta para o(s) pai(s); a GO é acíclica (DAG, pode ter vários pais).
// Sem ela, "DNA repair" acha 217 genes em vez de 475 (anotações vão no termo mais
// específico). No SPARQL: ?p :subprocessoDe* go:GO_0006281
relation ProcessoBiologico [0..*] -- subprocessoDe -- [0..*] ProcessoBiologico

// ===========================================================================
// 3. CÉLULAS (CL)                                             [mód. biologia]
// ===========================================================================

kind Celula {
    tipoCelular_idCL: const string [1]     // ex.: CL:0000182 (hepatocyte)
                                     // tipo do HPA sem termo exato -> termo CL mais geral
                                     // (ex.: "other brain neurons" -> CL:0000540 neuron)
}

// Contexto celular da própria anotação GO (coluna 16 do GAF: occurs_in(CL:...)).
// Caminho da QC4 só com GO + CL; convive com o HPA (ExpressaoGenica).
// Parcial: 46 dos 125 genes da QC2 têm esse contexto (124 tipos CL).
// Relação comum (hint implied-relation-stereotype aceito): não é @mediation (opcional,
// mínimo 0) nem dependência histórica; é só o contexto em que o processo ocorre.
// EM ABERTO (M4): pode virar @mediation [1..*] depois de medir o recorte do GAF.
relation AnotacaoFuncional [0..*] -- ocorreEm -- [0..*] Celula

// ===========================================================================
// 4. ORGANIZAÇÕES E RECURSOS                                  [mód. pesquisa]
// ===========================================================================

kind Organizacao {
    nome: string [1]             // ex.: HAGR, NHGRI-EBI, HGNC, GO Consortium
}

// Category: base de dados e ontologia têm identidades diferentes (como Gene e Variante).
// Kinds, não subkinds: o relator media ConjuntoDeDados, e um subkind mediado vira
// "role" para o Tonto (subkind-founded-on-relator). Ser base de dados é rígido.
category RecursoInformacional of functional-complexes

// Instâncias: LongevityMap, GenAge-Human, GWAS Catalog, HGNC, GO Annotations (GAF), HPA
kind ConjuntoDeDados specializes RecursoInformacional {
    nome: string [1]
    url: string [1]
}

// Instâncias: GO, CL, SO
kind Ontologia specializes RecursoInformacional {
    nome: string [1]
    url: string [1]
}

disjoint genset TiposDeRecurso {
    general RecursoInformacional
    specifics ConjuntoDeDados, Ontologia
}

relation RecursoInformacional [0..*] -- mantidoPor -- [1..*] Organizacao

// Ex.: GAF -> GO. O HPA NÃO usa a CL (o mapeamento é nosso).
relation ConjuntoDeDados [0..*] -- usaVocabulario -- [0..*] Ontologia

// ===========================================================================
// 5. ESTUDOS E POPULAÇÕES                                     [mód. pesquisa]
// ===========================================================================

// LongevityMap: rótulo tirado do artigo pelo curador (81 rótulos, texto livre).
// GWAS: ancestralidade + país de recrutamento (gwas-catalog-ancestry.tsv).
// kind (não collective): sem Pessoa no escopo, um collective ficaria sem membros.
// A população é identificada pelo rótulo do estudo.
kind Populacao {
    nome: string [1]
}

// Um estudo = um artigo (PMID). No GWAS, as análises (GCST) do mesmo artigo viram um
// Estudo só; o que as diferencia (população, traço) já fica na AssociacaoLongevidade.
kind Estudo {
    nome: string [1]             // título do artigo (via PubMed)
    pubmedId: const string [1]         // LongevityMap: 550/550; GWAS: 708/708; GAF: só quando PMID
}

relation Estudo [0..*] -- observa -- [0..*] Populacao

relation ConjuntoDeDados [0..*] -- relata -- [0..*] Estudo

// ===========================================================================
// 6. JUNÇÃO: OS FATOS (relatores que ligam biologia e pesquisa)       [novo]
// ===========================================================================

// --- 6.1 LongevityMap: associação com longevidade -------------------------

// Os 2 registros da LongevityMap sem significância não entram (vão para o log).
enum Significancia {
    Significativa,
    NaoSignificativa
}

// Um registro da LongevityMap ou do GWAS Catalog (filtrado para longevidade):
// resultado de um estudo, em uma ou mais populações, sobre um ou mais genes/variantes.
// Media a category ElementoGenomico: cada registro avalia ao menos um elemento, mas
// não necessariamente um gene nem uma variante. Se é gene ou variante, diz o kind.
//   LongevityMap (550): 432 gene + variante | 116 só gene | 2 só variante
//   GWAS (708): avalia a variante; o gene vem pela posição (localizadaEm)
relator AssociacaoLongevidade {
    idNaFonte: const string [1]                // LongevityMap: coluna id (ex.: G481);
                                         // GWAS: código GCST + rsID (ex.: GCST005467:rs429358)
    significancia: const Significancia [1]     // GWAS: sempre Significativa
    trait: const string [1]                    // termo do traço medido. GWAS: EFO de MAPPED_TRAIT_URI
                                         // (442 de 708 são EFO_0007796 parental longevity);
                                         // LongevityMap: sempre OBA_VT0005372 (life span)
    pValor: const number [0..1]                // GWAS: p-valor (todas <= 1e-5). A LongevityMap não
                                         // publica o valor (só a significância)
    @mediation [0..*] -- avaliaElemento -- [1..*] (const) ElementoGenomico
    @mediation [0..*] -- obtidaEm -- [1] (const) Estudo
    @mediation [0..*] -- observadaEm -- [1..*] (const) Populacao   // GWAS: 4 estudos multiancestrais
    @mediation [0..*] -- registradaEm -- [1] (const) ConjuntoDeDados
}

// --- 6.2 GenAge: evidência de envelhecimento -------------------------------

// Coluna "why" da GenAge (um gene pode ter vários motivos).
enum MotivoGenAge {
    Functional,
    Putative,
    Mammal,
    Downstream,
    Upstream,
    Model,
    Cell,
    HumanLink,
    Human
}

// Curadoria: "este gene tem relação com envelhecimento, por estes motivos".
// Sem Estudo: a fonte citada é a própria GenAge.
// Só os 307 genes da GenAge têm evidência; gene ausente da GenAge não tem nenhuma.
relator EvidenciaEnvelhecimento {
    idNaFonte: const string [1]                // coluna GenAge ID
    motivo: MotivoGenAge [1..*]
    @mediation [0..*] -- sobreGene -- [1] (const) Gene
    @mediation [0..*] -- curadaPor -- [1] (const) ConjuntoDeDados
}

// --- 6.3 GAF: anotação funcional (gene participa de processo) --------------

// Uma linha do goa_human.gaf (aspecto P, sem qualificador NOT).
relator AnotacaoFuncional {
    codigoEvidencia: const string [1]  // GO Evidence Code: IDA, IMP ... IEA (talvez ECO)
    referencia: const string [1]       // PMID:... ou GO_REF:... (método)
    @mediation [0..*] -- anotaGene -- [1] (const) Gene
    @mediation [0..*] -- emProcesso -- [1] (const) ProcessoBiologico
    @mediation [0..*] -- anotadaEm -- [1] (const) ConjuntoDeDados
}

// Quando a referência é um PMID, a anotação se apoia num estudo.
// Dependência histórica: a anotação veio de um estudo já feito, e isso não muda
// (const); um estudo só acumula anotações (addOnly).
// [0..1]: uma referência por linha; anotações IEA/GO_REF não vêm de estudo.
// (Não é @mediation: mediation exige mínimo 1.)
@historicalDependence relation AnotacaoFuncional (addOnly) [0..*] -- baseadaEm -- [0..1] (const) Estudo

// --- 6.4 HPA: expressão do gene por tipo celular ---------------------------
// Recorte: só genes da LongevityMap/GenAge e nCPM >= 1 (o HPA tem 3,1 mi linhas).

relator ExpressaoGenica {
    nCPM: const number [1]             // nível de expressão (unidade do HPA: normalized counts per million)
    @mediation [0..*] -- expressaGene -- [1] (const) Gene
    @mediation [0..*] -- emCelula -- [1] (const) Celula
    @mediation [0..*] -- medidaEm -- [1] (const) ConjuntoDeDados
}
